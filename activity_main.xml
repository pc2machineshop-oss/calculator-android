<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="bottom|end"
        android:maxLines="1"
        android:padding="16dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="56sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button style="@style/CalcFn"
            android:text="C" />
        <Button style="@style/CalcFn"
            android:text="⌫" />
        <Button style="@style/CalcFn"
            android:text="±" />
        <Button style="@style/CalcOp"
            android:text="÷" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button style="@style/CalcBtn"
            android:text="7" />
        <Button style="@style/CalcBtn"
            android:text="8" />
        <Button style="@style/CalcBtn"
            android:text="9" />
        <Button style="@style/CalcOp"
            android:text="×" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button style="@style/CalcBtn"
            android:text="4" />
        <Button style="@style/CalcBtn"
            android:text="5" />
        <Button style="@style/CalcBtn"
            android:text="6" />
        <Button style="@style/CalcOp"
            android:text="−" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button style="@style/CalcBtn"
            android:text="1" />
        <Button style="@style/CalcBtn"
            android:text="2" />
        <Button style="@style/CalcBtn"
            android:text="3" />
        <Button style="@style/CalcOp"
            android:text="+" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button style="@style/CalcBtn"
            android:layout_weight="2"
            android:text="0" />
        <Button style="@style/CalcBtn"
            android:text="." />
        <Button style="@style/CalcOp"
            android:text="=" />
    </LinearLayout>
</LinearLayout>
